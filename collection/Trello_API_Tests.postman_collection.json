  "item": [
    {
      "name": "Get All Boards",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/1/members/me/boards?key={{key}}&token={{token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "1",
            "members",
            "me",
            "boards"
          ],
          "query": [
            {
              "key": "key",
              "value": "{{key}}"
            },
            {
              "key": "token",
              "value": "{{token}}"
            }
          ]
        },
        "description": "Accidentally added a {name} board, forgot to del it, so decided to find a way to get all boards because didnt find a Get boards request in the DOCs"
      },
      "response": []
    },
    {
      "name": "Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let jsonData = pm.response.json();\r\npm.environment.set(\"boardID\", jsonData.id);\r\n\r\npm.test(\"Response contains id\", function () {\r\n    pm.expect(jsonData).to.have.property(\"id\");\r\n    pm.expect(jsonData.id).to.exist;\r\n});\r\n\r\npm.test(\"Response contains name\", function () {\r\n    pm.expect(jsonData).to.have.property(\"name\");\r\n    pm.expect(jsonData).to.exist;\r\n});\r\n\r\npm.test(\"Response contains url\", function () {\r\n    pm.expect(jsonData).to.have.property(\"url\");\r\n    pm.expect(jsonData).to.exist;\r\n});\r\n\r\nlet createdboardName = pm.environment.get(\"BoardName\");\r\npm.test(\"Board Name is correct\", function () {\r\n    pm.expect(jsonData.name).to.eql(createdboardName);\r\n});\r\n"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate a random number between 100 and 999\r\nconst randomNumber = Math.floor(Math.random() * 900) + 100;\r\n\r\n// Combine prefix and random number\r\nconst dynamicBoard = `myboard${randomNumber}`;\r\n\r\n// Save it as a collection or local variable\r\npm.environment.set(\"BoardName\", dynamicBoard);\r\n\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
