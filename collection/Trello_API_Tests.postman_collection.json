          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let jsonData = pm.response.json();\r\npm.environment.set(\"listID\", jsonData.id);\r\n\r\npm.test(\"Response contains id\", function () {\r\n    pm.expect(jsonData).to.have.property(\"id\");\r\n    pm.expect(jsonData.id).to.exist;\r\n});\r\n\r\npm.test(\"Response contains name\", function () {\r\n    pm.expect(jsonData).to.have.property(\"name\");\r\n    pm.expect(jsonData).to.exist;\r\n});\r\n\r\nlet createdlistName = pm.environment.get(\"ListName\");\r\npm.test(\"List Name is correct\", function () {\r\n    pm.expect(jsonData.name).to.eql(createdlistName);\r\n});\r\n"
